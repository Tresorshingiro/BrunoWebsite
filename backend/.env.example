# Database
# NOTE: server.js reads MONGO_URI — this file previously documented MONGODB_URI.
MONGO_URI=mongodb://localhost:27017/brunowebsite

JWT_SECRET=your_jwt_secret_key_here
CLIENT_ORIGIN=http://localhost:5173
PORT=5000

# Flutterwave (test keys shown; live keys are the same names)
FLW_PUBLIC_KEY=FLWPUBK_TEST-xxxxxxxx-X
FLW_SECRET_KEY=FLWSECK_TEST-xxxxxxxx-X
# Not read by this codebase. It exists for direct card charges, where you
# encrypt the card payload yourself; we use Flutterwave's hosted modal instead,
# so card data never reaches our server. Listed only because the dashboard
# shows it alongside the other two.
FLW_ENCRYPTION_KEY=FLWSECK_TESTxxxxxxxx
# Invent this, then paste the same value into the dashboard webhook config.
FLW_SECRET_HASH=some_long_random_string

# Cloudinary
CLOUDINARY_NAME=
CLOUDINARY_KEY=
CLOUDINARY_SECRET_KEY=

# Email
SENDGRID_API_KEY=
SENDGRID_FROM_EMAIL=
NOTIFY_EMAIL=
# From address for blog-subscription mail (subscriberController).
EMAIL_USER=
